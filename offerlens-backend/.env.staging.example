# ============================================
# OfferLens Backend - STAGING Environment
# ============================================
# This file shows example configuration for staging deployment

# ============================================
# Server Configuration
# ============================================
NODE_ENV=staging
PORT=3001
HOST=0.0.0.0

# ============================================
# CORS Configuration
# ============================================
# Your staging frontend URL
CORS_ORIGIN=https://your-staging-frontend.vercel.app

# ============================================
# Database Configuration
# ============================================
# Railway automatically provides this via PostgreSQL plugin
# DATABASE_URL=postgresql://postgres:xxxxx@containers-us-west-xxx.railway.app:5432/railway

# ============================================
# Redis Configuration
# ============================================
# Railway automatically provides this via Redis plugin
# REDIS_URL=redis://default:xxxxx@containers-us-west-xxx.railway.app:6379

# ============================================
# JWT Configuration
# ============================================
# Generate with: openssl rand -base64 32
JWT_SECRET=your-staging-secret-key
JWT_EXPIRES_IN=7d

# ============================================
# Admin Configuration
# ============================================
ADMIN_EMAIL=admin@yourdomain.com

# ============================================
# Email Configuration
# ============================================
EMAIL_API_KEY=your-staging-email-api-key
EMAIL_FROM=noreply@yourdomain.com

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=10

# ============================================
# File Upload
# ============================================
MAX_FILE_SIZE_MB=10

# ============================================
# Logging
# ============================================
LOG_LEVEL=info
