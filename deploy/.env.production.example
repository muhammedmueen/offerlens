# OfferLens — production env for the VPS compose stack.
#
# Copy to .env.production (same directory as docker-compose.prod.yml) and fill in the blanks:
#   cp .env.production.example .env.production
#   chmod 600 .env.production
#
# .env.production is gitignored. .env.production.example (this file) is committed — it holds
# PLACEHOLDERS ONLY, never a real secret.
#
# This file is read by every service via `env_file: .env.production`. Compose passes these into
# the containers; it does NOT interpolate them into the compose file itself.

# ── Server ────────────────────────────────────────────────────────────────
NODE_ENV=production
# PORT is left to the container (the image exposes 8000; host nginx -> 127.0.0.1:8100 -> 8000).
# Do not set PORT here unless you also change the compose port mapping.

# The one public origin. Host nginx serves the frontend AND proxies /api/ from the same origin,
# so this is the site URL with no path and no trailing slash.
CORS_ORIGIN=https://offerlens.mueens.tech

# ── Database (PostgreSQL — compose service `postgres`) ────────────────────
# Host is the compose service name `postgres`, reachable on the offerlens network. The user,
# db and password must match POSTGRES_PASSWORD below (user=offerlens, db=offerlens are set in
# the compose file).
DATABASE_URL=postgres://offerlens:__POSTGRES_PASSWORD__@postgres:5432/offerlens

# Password for the postgres service AND the DATABASE_URL above. Generate one and paste the
# SAME value into both this line and DATABASE_URL:
#   openssl rand -base64 24
POSTGRES_PASSWORD=__POSTGRES_PASSWORD__

# ── Redis (compose service `redis`) ───────────────────────────────────────
# Plain redis:// only (BullMQ ignores TLS/username/db-index — see docs/DEPLOYMENT.md section 1).
# No password: redis has no published port and is only reachable on the offerlens network.
REDIS_URL=redis://redis:6379

# ── Secrets ───────────────────────────────────────────────────────────────
# REQUIRED, minimum 32 characters each. Generate three distinct values:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# (or on the server without Node:  openssl rand -base64 48 | tr -d '\n' )
JWT_SECRET=__GENERATE_32_PLUS_CHARS__
JWT_REFRESH_SECRET=__GENERATE_A_DIFFERENT_32_PLUS_CHARS__
# Signs the guest identity cookie. Set it explicitly in production (do not leave it blank —
# an empty value fails boot; a missing line falls back to JWT_SECRET).
COOKIE_SECRET=__GENERATE_ANOTHER_32_PLUS_CHARS__

# ── Reverse proxy ─────────────────────────────────────────────────────────
# One host nginx hop in front of the API, so rate-limit and login-IP buckets see the real
# client IP. 0 would be off. See docs/DEPLOYMENT.md section 7.
TRUST_PROXY=1

# ── Storage ───────────────────────────────────────────────────────────────
# MUST be /app/uploads: that is where the shared `uploads` volume is mounted in both the api
# and workers containers (see docker-compose.prod.yml).
STORAGE_PATH=/app/uploads

# ── AI provider ───────────────────────────────────────────────────────────
# gemini | openai | anthropic | mock. With no key for the selected provider the app silently
# falls back to the MOCK provider (canned analysis). Confirm the logs do NOT contain
# `using MockAiProvider` after boot.
AI_PROVIDER=gemini
GEMINI_API_KEY=__GEMINI_API_KEY__

# ── Google OAuth (optional "Sign in with Google") ─────────────────────────
# Client ID only. Same client as the frontend build's VITE_GOOGLE_CLIENT_ID. Leave blank to
# disable the Google sign-in button (/auth/google then returns 503).
GOOGLE_CLIENT_ID=

# ── OCR (images and scanned PDFs) ─────────────────────────────────────────
# Which provider serves OCR: mock | google | azure. Unset/mock = image & scanned-PDF OCR is
# refused with 400 OCR_UNAVAILABLE (image uploads are off until a real provider is configured).
#
# RECOMMENDED: azure — Azure AI Document Intelligence (prebuilt-read) reads images AND scanned
# PDFs in one integration (Vision rejects PDFs). Deploy decisions: S0 pay-as-you-go tier, region
# Central India (data stays in-region), budget alert set in the Azure portal. The endpoint URL
# encodes the region; the KEY is a secret — set it here, chmod 600, and never commit it.
# webp is NOT an accepted upload type (Azure Read does not accept it).
OCR_PROVIDER=mock
# AZURE_DOC_INTELLIGENCE_ENDPOINT=https://<resource-name>.cognitiveservices.azure.com
# AZURE_DOC_INTELLIGENCE_KEY=__AZURE_DOC_INTELLIGENCE_KEY__

# OCR_PROVIDER=google — Cloud Vision, images only. Path INSIDE the container to a service-account
# JSON (requires a bind mount in the compose file).
# GOOGLE_CLOUD_CREDENTIALS=

# ── Logging ───────────────────────────────────────────────────────────────
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
