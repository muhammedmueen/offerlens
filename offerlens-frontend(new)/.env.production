# ============================================
# OfferLens Next.js Frontend - Production Environment
# ============================================
# IMPORTANT: These values should be set in Vercel dashboard
# Settings → Environment Variables → Production
# DO NOT commit actual production values to git

# ============================================
# API Configuration
# ============================================
# Backend API URL (without /api/v1 suffix)
# Example: https://api.offerlens.com
NEXT_PUBLIC_API_URL=https://api.offerlens.com

# ============================================
# Application Configuration
# ============================================
# Production application URL
# Example: https://offerlens.com
NEXT_PUBLIC_APP_URL=https://offerlens.com

# ============================================
# Analytics Configuration
# ============================================
# Enable analytics in production
NEXT_PUBLIC_ENABLE_ANALYTICS=true

# Vercel Analytics ID (optional - auto-detected if using Vercel Analytics)
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=

# ============================================
# Feature Flags
# ============================================
# Enable forum feature
NEXT_PUBLIC_ENABLE_FORUM=true

# Enable feature request form
NEXT_PUBLIC_ENABLE_FEATURE_REQUESTS=true

# ============================================
# Error Tracking (Optional)
# ============================================
# Sentry DSN for production error tracking
# Get from: https://sentry.io/settings/projects/
NEXT_PUBLIC_SENTRY_DSN=

# Sentry environment
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production

# ============================================
# Performance Configuration
# ============================================
# Disable debug mode in production
NEXT_PUBLIC_DEBUG=false

# API request timeout (30 seconds)
NEXT_PUBLIC_API_TIMEOUT=30000

# ============================================
# Security Notes
# ============================================
# - Never commit sensitive values to git
# - Set all values in Vercel dashboard
# - Use different values for preview/production
# - Rotate secrets regularly
# - Monitor for exposed secrets
