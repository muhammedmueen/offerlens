# ============================================
# OfferLens Next.js Frontend Environment Configuration
# ============================================
# Copy this file to .env.local and update values for your environment

# ============================================
# API Configuration
# ============================================
# Backend API URL (without /api/v1 suffix - handled by API client)
# Development: http://localhost:3001
# Staging: https://offerlens-backend-staging.railway.app
# Production: https://api.offerlens.com
NEXT_PUBLIC_API_URL=http://localhost:3001

# ============================================
# Application Configuration
# ============================================
# Application URL (used for canonical URLs and social sharing)
# Development: http://localhost:3000
# Staging: https://offerlens-staging.vercel.app
# Production: https://offerlens.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================
# Analytics Configuration
# ============================================
# Enable analytics tracking (true/false)
# Development: false
# Staging: false
# Production: true
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# Vercel Analytics ID (optional - leave empty to use default)
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=

# ============================================
# Feature Flags
# ============================================
# Enable forum feature (true/false)
NEXT_PUBLIC_ENABLE_FORUM=true

# Enable feature request form (true/false)
NEXT_PUBLIC_ENABLE_FEATURE_REQUESTS=true

# ============================================
# Error Tracking (Optional)
# ============================================
# Sentry DSN for error tracking (leave empty to disable)
NEXT_PUBLIC_SENTRY_DSN=

# Sentry environment name
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development

# ============================================
# Performance Configuration
# ============================================
# Enable debug mode (shows additional logging)
NEXT_PUBLIC_DEBUG=false

# API request timeout in milliseconds
NEXT_PUBLIC_API_TIMEOUT=30000

# ============================================
# Build Configuration (Internal - Do Not Modify)
# ============================================
# These are set automatically by the build process
# NODE_ENV=development|production
# NEXT_PUBLIC_VERCEL_ENV=development|preview|production
# NEXT_PUBLIC_VERCEL_URL=auto-generated-by-vercel
