# ============================================
# OfferLens Next.js Frontend - Staging Environment
# ============================================
# IMPORTANT: These values should be set in Vercel dashboard
# Settings → Environment Variables → Preview
# DO NOT commit actual staging values to git

# ============================================
# API Configuration
# ============================================
# Backend API URL (without /api/v1 suffix)
# Example: https://offerlens-backend-staging.railway.app
NEXT_PUBLIC_API_URL=https://offerlens-backend-staging.railway.app

# ============================================
# Application Configuration
# ============================================
# Staging application URL
# Example: https://offerlens-staging.vercel.app
NEXT_PUBLIC_APP_URL=https://offerlens-staging.vercel.app

# ============================================
# Analytics Configuration
# ============================================
# Disable analytics in staging
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# Vercel Analytics ID (optional)
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=

# ============================================
# Feature Flags
# ============================================
# Enable all features for testing
NEXT_PUBLIC_ENABLE_FORUM=true
NEXT_PUBLIC_ENABLE_FEATURE_REQUESTS=true

# ============================================
# Error Tracking (Optional)
# ============================================
# Sentry DSN for staging error tracking
NEXT_PUBLIC_SENTRY_DSN=

# Sentry environment
NEXT_PUBLIC_SENTRY_ENVIRONMENT=staging

# ============================================
# Performance Configuration
# ============================================
# Enable debug mode in staging for troubleshooting
NEXT_PUBLIC_DEBUG=true

# API request timeout (30 seconds)
NEXT_PUBLIC_API_TIMEOUT=30000

# ============================================
# Staging Notes
# ============================================
# - Use staging for testing before production
# - Test with production-like data
# - Verify all integrations work
# - Check performance metrics
# - Test error scenarios
