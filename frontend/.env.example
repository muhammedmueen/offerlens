# OfferLens Frontend — Environment Variables
# Copy to .env and adjust:  cp .env.example .env
#
# Vite only exposes variables prefixed with VITE_, and they are inlined into the bundle at
# build time. Never put a secret here — anything in this file is public.

# Backend API base URL. Must match the backend's PORT (8000 by default). The previous
# default pointed at 5000, so nothing worked until this was overridden by hand.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Google OAuth client ID for "Sign in with Google".
# Public by design — OAuth client IDs are visible in any browser client. Leave blank to
# hide the Google sign-in button.
VITE_GOOGLE_CLIENT_ID=
