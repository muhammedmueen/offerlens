# ============================================
# OfferLens Backend Environment Configuration
# ============================================
# Copy this file to .env and update values for your environment
# For production deployment, see deployment documentation

# ============================================
# Server Configuration
# ============================================
NODE_ENV=development
PORT=3001
HOST=localhost

# ============================================
# CORS Configuration
# ============================================
# Comma-separated list of allowed origins
# Development: http://localhost:5173
# Production: https://yourdomain.com
CORS_ORIGIN=http://localhost:5173

# ============================================
# Database Configuration
# ============================================
# Railway: Automatically provided as DATABASE_URL by PostgreSQL plugin
# Local: postgresql://user:password@localhost:5432/offerlens_dev
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://user:password@localhost:5432/offerlens_dev

# ============================================
# Redis Configuration
# ============================================
# Railway: Automatically provided as REDIS_URL by Redis plugin
# Local: redis://localhost:6379
# Format: redis://host:port or redis://username:password@host:port
REDIS_URL=redis://localhost:6379

# ============================================
# JWT Configuration
# ============================================
# IMPORTANT: Generate a strong secret for production
# Example: openssl rand -base64 32
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# ============================================
# Admin Configuration
# ============================================
# Email address for admin notifications
ADMIN_EMAIL=admin@offerlens.com

# ============================================
# Email Configuration
# ============================================
# For feature request notifications
# Configure your email service provider API key
EMAIL_API_KEY=your-email-api-key
EMAIL_FROM=noreply@offerlens.com

# ============================================
# Rate Limiting
# ============================================
# Window in milliseconds (default: 60000 = 1 minute)
RATE_LIMIT_WINDOW_MS=60000
# Maximum requests per window (default: 10)
RATE_LIMIT_MAX_REQUESTS=10

# ============================================
# File Upload
# ============================================
# Maximum file size in MB (default: 10)
MAX_FILE_SIZE_MB=10

# ============================================
# Logging
# ============================================
# Levels: error, warn, info, debug
# Production: info or warn
# Development: debug
LOG_LEVEL=info
