# OfferLens Backend — Environment Variables
# Copy to .env and fill in the blanks:  cp .env.example .env
#
# Everything marked REQUIRED is validated at boot by src/config/env.schema.ts. The server
# will refuse to start if one is missing or too short, rather than failing later.

# ── Server ────────────────────────────────────────────────────────────────
PORT=8000
# development | production | test. Set `production` on any deployed server: it makes the
# guest cookie Secure, refuses the AI request override and hides the dev model picker.
NODE_ENV=development

# Origin allowed to call this API. Must be the frontend's dev server, which Vite serves
# on 8080 (see frontend/vite.config.ts). Credentialed requests cannot use a wildcard,
# because the guest identity cookie is sent cross-origin.
CORS_ORIGIN=http://localhost:8080

# ── Database (PostgreSQL) ─────────────────────────────────────────────────
# REQUIRED. Matches backend/docker-compose.yml, so `docker compose up -d` just works.
# WARNING: postgres:postgres is for local compose only. Never use it on a deployed database.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/offerlens

# ── Redis (BullMQ queues + rate limiting) ─────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Secrets ───────────────────────────────────────────────────────────────
# REQUIRED, minimum 32 characters each. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# Optional. Signs the guest identity cookie (ADR-001). Falls back to JWT_SECRET when
# unset, which is fine locally. If set it must be 32+ characters (a blank value fails boot,
# so this line stays commented out). Set it explicitly in production so rotating one
# credential does not invalidate the other.
# COOKIE_SECRET=

# ── Google Cloud Vision (OCR fallback for scanned documents) ──────────────
# Optional. Path to a service account key JSON file. Without it the app uses a mock OCR
# provider, which is usually what you want locally.
GOOGLE_CLOUD_CREDENTIALS=

# ── AI provider ───────────────────────────────────────────────────────────
# Which provider serves AI calls: gemini | openai | anthropic | mock
#
# Gemini is the default because it is the one with a usable free tier. With no key for the
# selected provider the app falls back to the mock, which returns canned analysis — fine
# locally, useless as a measurement.
AI_PROVIDER=gemini

# Provide a key for whichever provider you selected. Only that one is needed.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional. Pin a specific model, overriding the provider's default. Leave blank unless you
# have a reason — each provider already picks a sensible model per task, and a model id from
# one provider is meaningless to another.
GEMINI_MODEL=
OPENAI_MODEL=
ANTHROPIC_MODEL=

# Lets a request choose its provider, model and API key with the X-AI-Provider,
# X-AI-Model and X-AI-Key headers. Intended for switching providers during development
# without editing this file and restarting.
#
# DEVELOPMENT ONLY, and refused in production regardless of this value — an endpoint that
# accepts arbitrary credentials and arbitrary model names lets a caller bill expensive models
# to your key, or proxy requests on someone else's credentials from your IP. Off by default,
# so a non-production deployment does not get it merely by not being production.
#
# Leave this line commented out to keep it off. Any non-empty value, including `false` and
# `0`, parses as TRUE (z.coerce.boolean). To enable it in development, set it to `true`.
# ALLOW_AI_REQUEST_OVERRIDE=true

# ── Google OAuth (optional "Sign in with Google") ─────────────────────────
# Client ID only: the backend verifies the ID token's audience against it. Must be the same
# client as the frontend's VITE_GOOGLE_CLIENT_ID. (No client secret is needed or read.)
GOOGLE_CLIENT_ID=

# ── Storage ───────────────────────────────────────────────────────────────
# Where uploaded offer files are written.
STORAGE_PATH=./uploads

# ── Logging ───────────────────────────────────────────────────────────────
# Fastify/pino level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
